RunService.Heartbeat:Connect(function()
    if not isRunning or isCustomRoutineRunning then return end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        return 
    end
    local hrp = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter

    -- 1. Deep check for "Throw" visibility anywhere in PlayerGui
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    throwIsVisible = false
    
    if playerGui then
        local throwObj = findDeepChild(playerGui, "Throw")
        if throwObj and throwObj:IsA("GuiObject") then
            throwIsVisible = throwObj.Visible
        end
    end

    if throwIsVisible then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        if selectedTrapMode == "Default (Lava)" then
            local lavaPart = findDeepChild(Workspace, "Lava")
            if lavaPart and lavaPart:IsA("BasePart") then
                hrp.CFrame = lavaPart.CFrame + Vector3.new(0, 3, 0)
                if humanoid then
                    pcall(function()
                        humanoid:ChangeState(Enum.HumanoidStateType.FallingDown)
                        task.wait(0.02)
                        humanoid:ChangeState(Enum.HumanoidStateType.Ragdoll)
                    end)
                end
            end
        elseif selectedTrapMode == "Custom Position & ClickRegion" then
            isCustomRoutineRunning = true
            
            -- Step 1: Teleport to custom position
            hrp.CFrame = option2CFrame
            
            -- Step 2: Wait for 1 second
            task.wait(1.0)
            
            -- Step 3: Click "ClickRegion" inside "Throw" frame
            if playerGui then
                local throwFrame = findDeepChild(playerGui, "Throw")
                if throwFrame then
                    local clickRegion = findDeepChild(throwFrame, "ClickRegion")
                    if clickRegion and (clickRegion:IsA("TextButton") or clickRegion:IsA("ImageButton")) then
                        pcall(function()
                            for _, connection in ipairs(getconnections(clickRegion.MouseButton1Click)) do
                                connection:Fire()
                            end
                            for _, connection in ipairs(getconnections(clickRegion.Activated)) do
                                connection:Fire()
                            end
                        end)
                    end
                end
            end
            
            -- Step 4: Wait for 0.5 seconds
            task.wait(0.5)
            
            -- Step 5: Teleport back to spawn location
            hrp.CFrame = getSpawnPositionCFrame()
            
            -- Step 6: Keep re-checking target until they are back in the "Ground" zone part
            while isRunning do
                task.wait(0.5)
                local targetPlayer = Players:FindFirstChild(selectedPlayerName)
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHRP = targetPlayer.Character.HumanoidRootPart
                    local groundPart = findDeepChild(Workspace, "Ground")
                    
                    if groundPart and groundPart:IsA("BasePart") then
                        local distance = (targetHRP.Position - groundPart.Position).Magnitude
                        if distance <= (groundPart.Size.Magnitude / 2) then
                            break
                        end
                    else
                        break
                    end
                else
                    break
                end
            end
            
            isCustomRoutineRunning = false
        end
        return 
    end

    -- 2. Target following logic
    if not selectedPlayerName then return end
    local targetPlayer = Players:FindFirstChild(selectedPlayerName)
    if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then 
        return 
    end
    local targetHRP = targetPlayer.Character.HumanoidRootPart

    -- Lock directly behind target player
    hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 0.5)
end)

