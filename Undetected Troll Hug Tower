-- 15 stud distance threshold from the part's outer bounds
MiscSection1:AddToggle("LavaProximityToggle", {
    Title = "Prevent from Touching Lava",
    Default = false
}):OnChanged(function(value)
    lavaAutoTeleportEnabled = value
    if lavaAutoTeleportEnabled then
        task.spawn(function()
            while lavaAutoTeleportEnabled do
                local char = game:GetService("Players").LocalPlayer.Character
                local rootPart = char and char:FindFirstChild("HumanoidRootPart")
                
                if rootPart and not isResetting then
                    local shouldTeleport = false
                    
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and obj.Name:lower() == "lava" then
                            local localPos = obj.CFrame:PointToObjectSpace(rootPart.Position)
                            local halfSize = obj.Size / 2
                            
                            local clampedX = math.clamp(localPos.X, -halfSize.X, halfSize.X)
                            local clampedY = math.clamp(localPos.Y, -halfSize.Y, halfSize.Y)
                            local clampedZ = math.clamp(localPos.Z, -halfSize.Z, halfSize.Z)
                            
                            local closestPointLocal = Vector3.new(clampedX, clampedY, clampedZ)
                            local closestPointWorld = obj.CFrame:PointToWorldSpace(closestPointLocal)
                            
                            local surfaceDistance = (rootPart.Position - closestPointWorld).Magnitude
                            
                            if surfaceDistance <= 15 then
                                shouldTeleport = true
                                break
                            end
                        end
                    end
                    
                    if shouldTeleport then
                        isResetting = true
                        rootPart.AssemblyLinearVelocity = Vector3.zero
                        rootPart.AssemblyAngularVelocity = Vector3.zero
                        rootPart.CFrame = getSpawnPositionCFrame()
                        task.wait(1.0)
                        isResetting = false
                    end
                end
                task.wait(0.05)
            end
        end)
    end
end)

